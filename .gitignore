/h3_*/
/tmptw*/
# Root-level transient experiment directories are disposable runtime artifacts.
/run_tmp*/
industrial_completion_outputs/
references/**/__pycache__/

# Stability continuation campaign outputs.  These remain disposable evidence
# files; source scripts and test fixtures are tracked separately.
/track_critical_root_*.csv
/track_followup_*.csv
/track_followup_*.json
/jtwpa_pump_m29p40.log
/jtwpa_pump_m29p40/
/stage_a/
/plot_artifacts/

# --- LaTeX build artifacts ---------------------------------------------------
# Every rule is scoped to thesis/, never blanket. Blanket *.aux/*.out/*.toc
# would shadow the tracked build products of the reports under
# docs/development/reports/, and a blanket *.log would shadow the run logs kept
# as reference artifacts under references/.
# The sources are tracked; everything a compiler regenerates is not. main.pdf
# is excluded too -- committing a build product makes every rebuild a diff.
thesis/*.aux
thesis/*.bbl
thesis/*.blg
thesis/*.fdb_latexmk
thesis/*.fls
thesis/*.lof
thesis/*.log
thesis/*.lot
thesis/*.out
thesis/*.pdf
thesis/*.synctex.gz
thesis/*.toc
